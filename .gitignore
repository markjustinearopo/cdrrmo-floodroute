# Supabase CLI scratch state (project ref, pooler URL, version pins)
supabase/.temp

# Local data snapshots (scripts/snapshot-data.mjs). These hold real officials'
# and residents' names, emails and phone numbers. This repository is public —
# committing one would be a far worse leak than anything it was taken to guard
# against. Never remove this line.
backups/

# Scratch backup written by scripts/enrich-road-names.mjs before it rewrites
# the road network. Regenerable, ~840 KB, and never the source of truth.
src/data/.roads.bak.json

# Generated login sheets (scripts/make-official-accounts.mjs). These carry
# officials' temporary passwords and this repository is PUBLIC — committing
# one repeats the 2026-08-31 leak. Never remove this line.
credentials/

# Thesis paperwork (data-gathering forms, evaluation questionnaire, test cases).
# They live in this folder because that is where the work happens, but they are
# not part of the system and this repository is public. Kept on disk, untracked.
CDRRMO_Data_Entry_Form.xlsx
CDRRMO_Data_Gathering_Checklist.xlsx
CDRRMO_Evaluation_Questionnaire.docx
CDRRMO_Test_Cases.docx
